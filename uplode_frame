from flask import Flask, request, jsonify
import base64
import cv2
import numpy as np

app = Flask(__name__)

@app.route("/upload_frame", methods=["POST"])
def upload_frame():
    try:
        data = request.json["image_base64"]
        # Remove the prefix (e.g., 'data:image/jpeg;base64,')
        data = data.split(",")[1]
        img_bytes = base64.b64decode(data)

        # Convert to NumPy array and then OpenCV image
        np_arr = np.frombuffer(img_bytes, np.uint8)
        img = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)

        # TODO: process the image with your model here
        # For now, just print its shape
        print("Frame received:", img.shape)

        return jsonify({"status": "success", "message": "Frame processed"})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
